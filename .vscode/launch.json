{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gnd-client (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/gnd/x64/Debug/gnd.exe",
      "args": [
        "--id",
        "sehui",
        "--dir",
        "${env:USERPROFILE}/agent-coord",
        "--repo",
        "${workspaceFolder}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "AGENT_COORD_DIR",
          "value": "${env:USERPROFILE}/agent-coord"
        },
        {
          "name": "CURSOR_PROJECT_DIR",
          "value": "${workspaceFolder}"
        },
        {
          "name": "PATH",
          "value": "${env:PATH};${workspaceFolder}/gnd/vcpkg_installed/x64-windows/debug/bin;${workspaceFolder}/gnd/vcpkg_installed/x64-windows/bin"
        }
      ],
      "preLaunchTask": "gnd-client build (Debug)",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
