{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gnd-client build (Debug)",
      "type": "shell",
      "command": "msbuild gnd.sln /p:Configuration=Debug /p:Platform=x64 /v:minimal",
      "options": {
        "cwd": "${workspaceFolder}/gnd",
        "shell": {
          "executable": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
          "args": ["-NoLogo", "-Command"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "gnd-client build (Release)",
      "type": "shell",
      "command": "vcpkg install --triplet x64-windows && msbuild gnd.sln /p:Configuration=Release /p:Platform=x64 /v:minimal",
      "options": {
        "cwd": "${workspaceFolder}/gnd",
        "shell": {
          "executable": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
          "args": ["-NoLogo", "-Command"]
        }
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "gnd-client (sehui)",
      "type": "shell",
      "command": "${workspaceFolder}/gnd/x64/Debug/gnd.exe --id sehui --dir ${env:USERPROFILE}/agent-coord",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AGENT_COORD_DIR": "${env:USERPROFILE}/agent-coord"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "AiRPG (sehui)",
      "type": "shell",
      "command": "node scripts/coord-chat.mjs --id sehui",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "G:\\ide\\Git\\bin\\bash.exe",
          "args": [
            "-lc"
          ]
        },
        "env": {
          "AGENT_COORD_DIR": "${env:USERPROFILE}/agent-coord"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "coord",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "agent-coord",
          "endsPattern": "type /help"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    }
  ]
}
