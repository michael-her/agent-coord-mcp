  "version": "0.2.0",
  "configurations": [
    {
      "name": "GND Engine - MSVC Launch",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/x64/Debug/gnd.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};${workspaceFolder}/vcpkg_installed/x64-windows/bin"
        }
      ],
      "console": "externalTerminal"
    }
  ]
}