{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gnd-client: debug in external pwsh",
      "dependsOn": ["gnd-client build (Debug)"],
      "type": "process",
      "command": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-File",
        "${workspaceFolder}/../.vscode/gnd-debug-launch.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}/..",
        "-AgentId",
        "sehui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "gnd-external",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "GND_DEBUG_READY"
        }
      }
    },
    {
      "label": "gnd-client run (integrated terminal)",
      "dependsOn": ["gnd-client build (Debug)"],
      "type": "shell",
      "command": "& '${workspaceFolder}/x64/Debug/gnd.exe' --id sehui --dir '${env:USERPROFILE}/agent-coord' --repo '${workspaceFolder}/..'",
      "options": {
        "cwd": "${workspaceFolder}/..",
        "shell": {
          "executable": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
          "args": ["-NoLogo", "-Command"]
        },
        "env": {
          "COLORTERM": "truecolor",
          "TERM": "xterm-256color",
          "AGENT_COORD_DIR": "${env:USERPROFILE}/agent-coord",
          "CURSOR_PROJECT_DIR": "${workspaceFolder}/..",
          "PATH": "${env:PATH};${workspaceFolder}/vcpkg_installed/x64-windows/debug/bin;${workspaceFolder}/vcpkg_installed/x64-windows/bin"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "gnd-client build (Debug)",
      "type": "shell",
      "command": "msbuild gnd.sln /p:Configuration=Debug /p:Platform=x64 /v:minimal",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
          "args": ["-NoLogo", "-Command"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
